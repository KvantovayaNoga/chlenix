# ============================================================
# Chlenix — переменные окружения (скопируйте в .env и заполните)
# cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=chlenix
# ОБЯЗАТЕЛЬНО задайте надёжный пароль (используется и в DATABASE_URL):
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=chlenix
POSTGRES_PORT=5432

# --- Backend API ---
# Секрет для подписи JWT-токенов. Сгенерируйте случайный, например:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_random_48_chars_secret
JWT_EXPIRES_IN=7d
BACKEND_PORT=4000

# --- CORS: адрес(а) фронтенда, разрешённые для запросов к API ---
# По умолчанию '*' — подходит для доступа по IP/домену без HTTPS.
# Для строгой политики перечислите точные origins через запятую:
#   CORS_ORIGIN=http://192.0.2.10,https://chlenix.example.ru
CORS_ORIGIN=*

# --- URL API для фронтенда (подставляется в сборку Vite на этапе build) ---
# Оставьте '/api' — nginx внутри контейнера проксирует запросы на backend.
# Менять нужно только при нестандартной топологии (отдельный домен API).
VITE_API_URL=/api

# --- Хост для доступа к фронтенду (порт nginx) ---
HTTP_PORT=80

# --- Сеть при сборке Docker (необязательно) ---
# Если registry.npmjs.org недоступен с вашего сервера, сборка образов будет
# «висеть» на шаге npm install. В этом случае укажите зеркало npm-реестра:
#   NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=
# Корпоративный прокси для контейнеров сборки (если нужен):
HTTP_PROXY=
HTTPS_PROXY=
