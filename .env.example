# ============================================================
# Chlenix — переменные окружения (скопируйте в .env и заполните)
# cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=chlenix
# ОБЯЗАТЕЛЬНО задайте надёжный пароль (используется и в DATABASE_URL):
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=chlenix
POSTGRES_PORT=5432

# --- Backend API ---
# Секрет для подписи JWT-токенов. Сгенерируйте случайный, например:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_random_48_chars_secret
JWT_EXPIRES_IN=7d
BACKEND_PORT=4000

# --- CORS: адрес фронтенда, разрешённый для запросов к API ---
CORS_ORIGIN=http://localhost

# --- URL API для фронтенда (подставляется в сборку Vite на этапе build) ---
# При стандартном docker-compose с nginx это http://ВАШ_СЕРВЕР/api
VITE_API_URL=http://localhost/api

# --- Хост для доступа к фронтенду (порт nginx) ---
HTTP_PORT=80
