+function displayValue(v: unknown): string {
+  if (v === null || v === undefined || v === '') return '—';
+  if (typeof v === 'boolean') return v ? 'да' : 'нет';
+  if (v instanceof Date) return v.toISOString().split('T')[0];
+  return String(v);
+}
