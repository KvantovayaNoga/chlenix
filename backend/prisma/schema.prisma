// ============================================================
// Prisma Schema для Chlenix IT Asset Management
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Пользователи системы (авторизация)
// ============================================================
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String   @map("password_hash")
  fullName       String   @map("full_name")
  role           Role     @default(viewer)
  isActive       Boolean  @default(true) @map("is_active")
  avatar         String?  @db.Text
  theme          String   @default("system")
  // Активная организация — та, где пользователь был в последней сессии
  // (последнее переключение/вход). Определяет скоуп данных при следующем входе.
  organizationId String?  @map("organization_id")
  // Версия токена: инкрементируется при переносе пользователя в другую
  // организацию — все ранее выданные JWT становятся недействительными
  // (принудительный разлогин), и при следующем входе он попадёт в новую организацию.
  tokenVersion   Int      @default(0) @map("token_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Связи
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  memberships       UserOrganization[]
  updatedByUser     User?              @relation("UserUpdater", fields: [updatedById], references: [id])
  updatedById       String?            @map("updated_by")
  updatedUsers      User[]             @relation("UserUpdater")
  employees         Employee[]         @relation("EmployeeUpdater")
  employeeProfile   Employee?          @relation("EmployeeUser")
  departments       Department[]       @relation("DepartmentUpdater")
  positions         Position[]         @relation("PositionUpdater")
  activityTypes     ActivityType[]     @relation("ActivityTypeUpdater")
  branches          Branch[]           @relation("BranchUpdater")
  dataCenters       DataCenter[]       @relation("DataCenterUpdater")
  equipment         Equipment[]        @relation("EquipmentUpdater")
  virtualMachines   VirtualMachine[]   @relation("VMUpdater")
  networkInterfaces NetworkInterface[] @relation("NIUpdater")
  services          Service[]          @relation("ServiceUpdater")
  auditLogs         AuditLog[]
  joinRequests      JoinRequest[]      @relation("JoinRequestApplicant")
  approvedRequests  JoinRequest[]      @relation("JoinRequestApprover")

  @@map("users")
}

// ============================================================
// Заявки на вступление в организацию (раздел «Администрирование»)
// Создаются при регистрации с выбором «Присоединиться к существующей
// организации». Администратор системы одобряет заявку, назначая роль;
// после одобрения пользователь привязывается к организации.
// ============================================================
model JoinRequest {
  id             String            @id @default(uuid())
  applicantId    String            @map("applicant_id")
  organizationId String            @map("organization_id")
  status         JoinRequestStatus @default(pending)
  // Роль, которую администратор системы назначил при одобрении
  assignedRole   Role?             @map("assigned_role")
  approverId     String?           @map("approver_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  applicant    User         @relation("JoinRequestApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  approver     User?        @relation("JoinRequestApprover", fields: [approverId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([applicantId])
  @@map("join_requests")
}

// ============================================================
// Членство пользователя в организациях (мультиорганизационность)
// Один пользователь может состоять сразу в нескольких организациях.
// Активная организация (users.organization_id) — та, где он был в
// последней сессии; при переносе администратором она меняется, а все
// выданные JWT инвалидируются через users.token_version (разлогин).
// ============================================================
model UserOrganization {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organizations")
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

enum Role {
  admin
  hr_specialist            // Специалист по кадрам
  sysadmin                 // Системный администратор
  materially_responsible
  viewer
}

// ============================================================
// Справочники
// ============================================================
model Department {
  id             String   @id @default(uuid())
  name           String
  description    String?
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by")

  updatedBy User?      @relation("DepartmentUpdater", fields: [updatedById], references: [id])
  employees Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Position {
  id             String   @id @default(uuid())
  name           String
  description    String?
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by")

  updatedBy User?      @relation("PositionUpdater", fields: [updatedById], references: [id])
  employees Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("positions")
}

model Branch {
  id             String   @id @default(uuid())
  name           String
  address        String
  description    String?
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by")

  updatedBy User?       @relation("BranchUpdater", fields: [updatedById], references: [id])
  employees Employee[]
  equipment Equipment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("branches")
}

// Справочник «Виды деятельности» (ОКВЭД). Две логические сущности:
// основной вид деятельности (isMain = true) и дополнительные (isMain = false).
// Основной вид всегда один — при выставлении флага у новой записи предыдущий
// основной автоматически становится дополнительным.
model ActivityType {
  id             String   @id @default(uuid())
  okved          String   // ОКВЭД: максимум 6 цифр, два разделителя в виде точек (XX.XX.XX)
  name           String   // Наименование вида деятельности
  isMain         Boolean  @default(false) @map("is_main")
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by")

  updatedBy User? @relation("ActivityTypeUpdater", fields: [updatedById], references: [id])

  @@index([organizationId])
  @@index([isMain])
  @@map("activity_types")
}

// Дата-центры (ЦОД): сторонние/облачные вычислительные мощности,
// которые может не принадлежать организации.
model DataCenter {
  id             String   @id @default(uuid())
  name           String
  owner          String
  address        String?
  description    String?
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by")

  updatedBy User?       @relation("DataCenterUpdater", fields: [updatedById], references: [id])
  // ЦОД может быть местом размещения оборудования (кластеры на арендованных/облачных мощностях)
  equipment Equipment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("data_centers")
}

// ============================================================
// Сотрудники
// ============================================================
model Employee {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  middleName     String?   @map("middle_name")
  positionId     String    @map("position_id")
  departmentId   String    @map("department_id")
  branchId       String?   @map("branch_id")
  email          String?
  workPhone      String?   @map("work_phone")
  internalPhone  String?   @map("internal_phone")
  personalPhone  String?   @map("personal_phone")
  hireDate       DateTime  @map("hire_date")
  birthDate      DateTime? @map("birth_date")
  avatar         String?   @db.Text
  userId         String?   @unique @map("user_id")
  isEmployed     Boolean   @default(true) @map("is_employed")
  floor          String?
  room           String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedById    String?   @map("updated_by")

  // Связи
  organization Organization? @relation(fields: [organizationId], references: [id])
  position     Position      @relation(fields: [positionId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  updatedBy    User?         @relation("EmployeeUpdater", fields: [updatedById], references: [id])
  linkedUser   User?         @relation("EmployeeUser", fields: [userId], references: [id])

  equipment            Equipment[]           @relation("AssignedEquipment")
  // Оборудование/имущество, числящееся за сотрудником как за МОЛ (материально
  // ответственное лицо) — на подотчёте
  molEquipment         Equipment[]           @relation("MolEquipment")
  vmResponsible        VirtualMachine[]      @relation("VMInfraResponsible")
  vmServiceResponsible VirtualMachine[]      @relation("VMServiceResponsible")
  // Виртуальные машины, числящиеся за сотрудником как за МОЛ
  molVirtualMachines   VirtualMachine[]      @relation("MolVirtualMachine")
  assignments          EquipmentAssignment[]

  @@index([departmentId])
  @@index([positionId])
  @@index([branchId])
  @@index([isEmployed])
  @@index([organizationId])
  @@map("employees")
}

// ============================================================
// Оборудование
// ============================================================
model Equipment {
  id                   String            @id @default(uuid())
  organizationId       String?           @map("organization_id")
  name                 String
  category             EquipmentCategory
  // Серийный/инвентарный номера необязательны: логические сущности (кластеры
  // виртуализации) не имеют физической инвентарной карточки.
  serialNumber         String?           @map("serial_number")
  inventoryNumber      String?           @unique @map("inventory_number")
  brand                String?
  model                String?
  purchaseDate         DateTime?         @map("purchase_date")
  writeOffDate         DateTime?         @map("write_off_date")
  condition            String            @default("exploitation") @db.Text
  // Дефект/причина ограничений: обязателен при статусе exploitation_restricted
  // (проверка на уровне API, см. equipmentSchema).
  defectNote           String?           @map("defect_note")
  assignedToEmployeeId String?           @map("assigned_to_employee_id")
  // МОЛ (материально ответственное лицо) — сотрудник, на подотчёте которого
  // числится это оборудование. Независимо от «закреплено за»: один сотрудник
  // может пользоваться техникой, а материальную ответственность несёт другой.
  materiallyResponsibleEmployeeId String? @map("materially_responsible_employee_id")
  // Место размещения: филиал организации (branchId, обязателен для физической техники)
  // ИЛИ внешний/облачный ЦОД (dataCenterId — используется кластерами на арендованных мощностях).
  // Для кластеров заполнен ровно один из двух: locationType указывает, какой именно.
  branchId             String?           @map("branch_id")
  dataCenterId         String?           @map("data_center_id")
  locationType         String?           @map("location_type") // 'branch' | 'data_center' | null (для обычной техники — филиал)
  floor                String?
  room                 String?
  // Роль в системе виртуализации: хост гипервизора / СХД / консоль управления / автономный
  serverRole           String?           @map("server_role")
  // Название гипервизора, если это хост (VMware ESXi, Proxmox VE, Hyper-V…)
  hypervisorName       String?           @map("hypervisor_name")
  // Имя кластера ВМ внутри гипервизора (vSphere HA Cluster, Proxmox cluster…)
  clusterName          String?           @map("cluster_name")
  // Версия гипервизора на хосте (ESXi 8.0 U2, PVE 8.2…)
  hypervisorVersion    String?           @map("hypervisor_version")
  // Параметры СХД: тип (san/nas/hci), протокол (iSCSI/FC/NFS…), полезный объём ГБ
  storageType          String?           @map("storage_type")
  storageProtocol      String?           @map("storage_protocol")
  // Полезный объём СХД хранится в ГБ (число с плавающей точкой — поддержка
  // дробных значений, введённых через запятую: 50,5 ТБ -> 51712 ГБ)
  storageCapacityGB    Float?            @map("storage_capacity_gb")
  // кластер-сервер (serverRole === 'cluster'): аккумулирует хосты и СХД внутри себя;
  // обычные поля clusterName/hypervisorName/hypervisorVersion используются как атрибуты кластера
  parentClusterId      String?           @map("parent_cluster_id")
  // Характеристики серверов (CPU/RAM/Disk)
  cpuCores             Int?              @map("cpu_cores")
  ramGB                Float?            @map("ram_gb")
  diskGB               Float?            @map("disk_gb")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  updatedById          String?           @map("updated_by")

  // Связи
  organization       Organization? @relation(fields: [organizationId], references: [id])
  assignedToEmployee Employee?     @relation("AssignedEquipment", fields: [assignedToEmployeeId], references: [id])
  // МОЛ — материально ответственное лицо, на подотчёте которого числится оборудование
  materiallyResponsibleEmployee Employee? @relation("MolEquipment", fields: [materiallyResponsibleEmployeeId], references: [id])
  branch             Branch?       @relation(fields: [branchId], references: [id])
  dataCenter         DataCenter?   @relation(fields: [dataCenterId], references: [id])
  updatedBy          User?         @relation("EquipmentUpdater", fields: [updatedById], references: [id])

  hostForVMs  VirtualMachine[]      @relation("HostServer")
  // ВМ кластера вычисляются через состав кластера (members.parentClusterId),
  // отдельная связь VmCluster удалена как дублирующая и противоречащая логике
  assignments EquipmentAssignment[]

  // Кластерные связи: кластер-сервер аккумулирует внутри себя хосты и СХД.
  parentCluster  Equipment?  @relation("EquipmentCluster", fields: [parentClusterId], references: [id], onDelete: SetNull)
  clusterMembers Equipment[] @relation("EquipmentCluster")

  @@index([parentClusterId])
  @@index([category])
  @@index([assignedToEmployeeId])
  @@index([materiallyResponsibleEmployeeId])
  @@index([condition])
  @@index([branchId])
  @@index([dataCenterId])
  @@index([organizationId])
  @@map("equipment")
}

enum EquipmentCategory {
  computer
  monitor
  peripheral
  furniture
  server
  storage
  virtual_machine
  network
  phone
  other
}

// Статусная модель оборудования (в UI — «Статус»). Значения соответствуют
// statusLabels на фронтенде и VALUE_TRANSLATIONS.condition на бэкенде.
// Хранится как TEXT с CHECK в БД (см. database/schema.sql и миграцию
// 20261104_equipment_status_model) — НЕ как enum PostgreSQL: enum-колонка
// при деплои через db push давала P3018 (ALTER TYPE ... ADD VALUE нельзя
// внутри транзакции) → backend нездоров → frontend не стартовал.
// Старые значения (new/good/satisfactory/needs_repair/written_off) перенесены
// миграцией; нормализация legacy-значений — normalizeCondition в src/index.ts.
// ============================================================
// Виртуальные машины
// ============================================================
model VirtualMachine {
  id                           String   @id @default(uuid())
  organizationId               String?  @map("organization_id")
  name                         String
  hostname                     String
  type                         VMType   @default(virtual)
  hostServerId                 String?  @map("host_server_id")
  // clusterId удалён: принадлежность ВМ к кластеру определяется автоматически
  // по хост-серверу (hostServer.parentClusterId). ВМ размещается на хосте,
  // а кластер — логическая группа хостов/СХД (см. Equipment.parentClusterId).
  os                           String?
  cpuCores                     Int      @default(2) @map("cpu_cores")
  // RAM/диск во Float — поддержка дробных значений (ввод через запятую: 4,5 ГБ)
  ramGB                        Float    @default(4) @map("ram_gb")
  diskGB                       Float    @default(50) @map("disk_gb")
  responsibleEmployeeId        String?  @map("responsible_employee_id")
  serviceResponsibleEmployeeId String?  @map("service_responsible_employee_id")
  // МОЛ (материально ответственное лицо) — сотрудник, на подотчёте которого
  // числится эта виртуальная машина (смежная сущность оборудования)
  materiallyResponsibleEmployeeId String? @map("materially_responsible_employee_id")
  status                       VMStatus @default(running)
  // Роль ВМ в системе виртуализации (например, консоль управления — vCenter как ВМ)
  serverRole                   String?  @map("server_role")
  // Назначенный хост гипервизора (thin provisioning)
  provisionedOn                String?  @map("provisioned_on")
  notes                        String?
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  updatedById                  String?  @map("updated_by")

  // Связи
  organization               Organization? @relation(fields: [organizationId], references: [id])
  hostServer                 Equipment?    @relation("HostServer", fields: [hostServerId], references: [id])
  responsibleEmployee        Employee?     @relation("VMInfraResponsible", fields: [responsibleEmployeeId], references: [id])
  serviceResponsibleEmployee Employee?     @relation("VMServiceResponsible", fields: [serviceResponsibleEmployeeId], references: [id])
  // МОЛ — материально ответственное лицо, на подотчёте которого числится ВМ
  materiallyResponsibleEmployee Employee?  @relation("MolVirtualMachine", fields: [materiallyResponsibleEmployeeId], references: [id])
  updatedBy                  User?         @relation("VMUpdater", fields: [updatedById], references: [id])

  networkInterfaces NetworkInterface[]
  services          Service[]

  @@index([organizationId])
  @@index([hostServerId])
  @@index([responsibleEmployeeId])
  @@index([serviceResponsibleEmployeeId])
  @@index([materiallyResponsibleEmployeeId])
  @@index([status])
  @@map("virtual_machines")
}

enum VMType {
  virtual
  container
  cloud
}

enum VMStatus {
  running
  stopped
  maintenance
  decommissioned
}

// ============================================================
// Сетевые интерфейсы
// ============================================================
model NetworkInterface {
  id               String   @id @default(uuid())
  virtualMachineId String   @map("virtual_machine_id")
  name             String
  macAddress       String   @map("mac_address")
  ipAddress        String   @map("ip_address")
  isPublic         Boolean  @default(false) @map("is_public")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedById      String?  @map("updated_by")

  virtualMachine VirtualMachine @relation(fields: [virtualMachineId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("NIUpdater", fields: [updatedById], references: [id])

  @@unique([virtualMachineId, name])
  @@index([ipAddress])
  @@index([macAddress])
  @@map("network_interfaces")
}

// ============================================================
// Сервисы на ВМ
// ============================================================
model Service {
  id               String        @id @default(uuid())
  virtualMachineId String        @map("virtual_machine_id")
  name             String
  version          String?
  // Порт(ы) сервиса: строка, чтобы поддерживать несколько портов через запятую (напр. "80, 443")
  port             String?
  description      String?
  status           ServiceStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  updatedById      String?       @map("updated_by")

  virtualMachine VirtualMachine @relation(fields: [virtualMachineId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("ServiceUpdater", fields: [updatedById], references: [id])

  @@index([virtualMachineId])
  @@index([port])
  @@map("services")
}

enum ServiceStatus {
  active
  inactive
  maintenance
}

// ============================================================
// История передач оборудования
// ============================================================
model EquipmentAssignment {
  id           String    @id @default(uuid())
  equipmentId  String    @map("equipment_id")
  employeeId   String    @map("employee_id")
  assignedBy   String    @map("assigned_by")
  assignedDate DateTime  @default(now()) @map("assigned_date")
  returnedDate DateTime? @map("returned_date")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([employeeId])
  @@map("equipment_assignments")
}

// ============================================================
// Аудит-лог
// ============================================================
model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  userName   String      @map("user_name")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  entityName String?     @map("entity_name")
  details    String?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

enum AuditAction {
  create
  update
  delete
  assign
  unassign
  login
  logout
}

// ============================================================
// Организации (карточка организации + реквизиты)
// ============================================================
model Organization {
  id                   String   @id @default(uuid())
  name                 String
  legalForm            String   @map("legal_form")
  shortName            String   @map("short_name")
  inn                  String
  kpp                  String?
  ogrn                 String
  legalAddress         String   @map("legal_address")
  actualAddress        String?  @map("actual_address")
  postalCode           String?  @map("postal_code")
  city                 String?
  phone                String?
  email                String?
  website              String?
  directorName         String?  @map("director_name")
  directorPosition     String?  @map("director_position")
  accountantName       String?  @map("accountant_name")
  bankName             String?  @map("bank_name")
  checkingAccount      String?  @map("checking_account")
  correspondentAccount String?  @map("correspondent_account")
  bik                  String?
  taxSystem            String?  @map("tax_system")
  industry             String?
  employeeCount        Int?     @map("employee_count")
  foundedDate          String?  @map("founded_date")
  logo                 String?  @db.Text
  notes                String?
  createdById          String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedById          String?  @map("updated_by")

  users           User[]
  memberships     UserOrganization[]
  joinRequests    JoinRequest[]
  employees       Employee[]
  equipment       Equipment[]
  virtualMachines VirtualMachine[]

  @@index([inn])
  @@map("organizations")
}

// ============================================================
// История изменений сущностей (field-level diff)
// ============================================================
model HistoryRecord {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  fieldName  String?  @map("field_name")
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  changedBy  String   @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")
  // Группировка изменений одного сохранения: записи, созданные в рамках одного
  // обновления сущности, получают общий batchId. Краткое поле-заголовок группы
  // («Обновлено: поле1, поле2…») хранится в записи с fieldName === 'изменения',
  // детализация по каждому полю — в остальных записях с тем же batchId.
  batchId    String?  @map("batch_id")

  @@index([entityType, entityId])
  @@index([batchId])
  @@map("history_records")
}
